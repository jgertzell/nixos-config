# Sway session for nix-laptop. Start it with `uwsm start sway-uwsm.desktop`.

set $mod Mod4
set $term kitty
set $fileManager thunar
set $menu rofi -show drun -theme sidebar
set $floatingTerminal kitty --class floating-terminal --title floating-terminal --override initial_window_width=90c --override initial_window_height=20c
set $lock pgrep -x swaylock >/dev/null || swaylock -f

### Appearance

default_border pixel 2
default_floating_border pixel 2
gaps inner 1
gaps outer 1

# class                 border  bg      text    indicator child_border
client.focused          #4c7899 #4c7899 #ffffff #4c7899   #4c7899
client.focused_inactive #333333 #333333 #ffffff #333333   #333333
client.unfocused        #333333 #333333 #888888 #333333   #333333

seat * xcursor_theme Bibata-Modern-Classic 24

### Outputs
# kanshi handles mode, position and scale. HDR (PQ/BT2020) needs the Vulkan
# renderer, which uwsm/env-sway sets.

output * bg #000000 solid_color
output DP-1 hdr on
output DP-3 hdr on

### Input

input type:keyboard {
    xkb_layout se
}

input type:touchpad {
    natural_scroll disabled
    tap enabled
}

focus_follows_mouse yes

bindgesture swipe:3:left workspace next_on_output
bindgesture swipe:3:right workspace prev_on_output

### Key bindings

bindsym $mod+F1 exec ~/.local/bin/hyprland-keybinds
bindsym $mod+F8 exec kitty --title nixos-switch fish -ic 'nixos-switch; read -P "Press Enter to close..."'
bindsym $mod+d exec $menu
bindsym $mod+r exec rofi -show run -theme sidebar
bindsym $mod+Return exec $term
bindsym $mod+Shift+Return exec $floatingTerminal
bindsym $mod+q kill
bindsym $mod+m exec swaynag -t warning -m 'Exit sway?' -B 'Exit' 'swaymsg exit'
bindsym $mod+l exec $lock
bindsym $mod+p exec kitty --title monitorswitch fish -ic 'swaymsg output eDP-1 enable; systemctl --user restart kanshi.service; kanshictl reload'
bindsym $mod+Shift+h output - hdr toggle

bindsym $mod+Shift+space floating toggle; [con_id=__focused__ floating] resize set 854 480, move position center
bindsym $mod+j layout toggle split
bindsym $mod+f fullscreen toggle

bindsym $mod+Left focus left
bindsym $mod+Right focus right
bindsym $mod+Up focus up
bindsym $mod+Down focus down

bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

# Scratchpad replaces Hyprland's special:magic workspace.
bindsym $mod+s scratchpad show
bindsym $mod+Shift+a move scratchpad

bindsym $mod+Shift+s exec grim -g "$(slurp)" - | swappy -f -

bindsym --whole-window $mod+button5 workspace next_on_output
bindsym --whole-window $mod+button4 workspace prev_on_output
floating_modifier $mod normal

bindsym --locked XF86AudioRaiseVolume exec wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+
bindsym --locked XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym --locked XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym --locked XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindsym --locked XF86MonBrightnessUp exec brightnessctl -e4 -n2 set 5%+
bindsym --locked XF86MonBrightnessDown exec brightnessctl -e4 -n2 set 5%-
bindsym --locked XF86AudioNext exec playerctl next
bindsym --locked XF86AudioPause exec playerctl play-pause
bindsym --locked XF86AudioPlay exec playerctl play-pause
bindsym --locked XF86AudioPrev exec playerctl previous

bindsym $mod+e mode "execute"
mode "execute" {
    bindsym e exec $fileManager; mode "default"
    bindsym t exec $term; mode "default"
    bindsym p exec $term pwsh; mode "default"
    bindsym f exec firefox; mode "default"
    bindsym d exec $menu; mode "default"
    bindsym Escape mode "default"
    bindsym Return mode "default"
}

### Window rules

for_window [app_id="floating-terminal"] floating enable

### Session
# Hands the environment to uwsm and starts graphical-session.target units
# (waybar, kanshi, dunst, swayidle).

exec exec uwsm finalize SWAYSOCK I3SOCK XCURSOR_SIZE XCURSOR_THEME
