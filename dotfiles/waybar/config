{
  "layer": "top",
  "position": "bottom",
  "height": 20,
  "spacing": 0,
  "modules-left": ["hyprland/workspaces"],
  "modules-center": [],
  "modules-right": ["cpu", "temperature", "memory", "pulseaudio", "network", "battery", "power-profiles-daemon", "custom/coffee", "clock", "tray"],
  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "all-outputs": true,
    "sort-by-number": true
  },
  "clock": {
    "format": "{:%a %d %b %H:%M}"
  },
  "cpu": {
    "interval": 5,
    "format": "CPU {usage}%"
  },
  "temperature": {
    "interval": 5,
    "format": "CPU {temperatureC}C",
    "critical-threshold": 85
  },
  "memory": {
    "interval": 5,
    "format": "MEM {used:0.1f}G/{avail:0.1f}G"
  },
  "battery": {
    "format": "BAT {capacity}%",
    "format-charging": "CHR {capacity}%",
    "format-plugged": "AC {capacity}%"
  },
  "network": {
    "format-wifi": "W: {essid}",
    "format-ethernet": "E: {ipaddr}",
    "format-disconnected": "no net"
  },
  "pulseaudio": {
    "format": "VOL {volume}%",
    "format-muted": "MUTE"
  },
  "power-profiles-daemon": {
    "format": "PWR {icon}",
    "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
    "format-icons": {
      "performance": "PERF",
      "balanced": "BAL",
      "power-saver": "SAVE"
    }
  },
  "custom/coffee": {
    "exec": "/etc/profiles/per-user/jgertzell/bin/coffee-mode status",
    "return-type": "json",
    "interval": 5,
    "signal": 8,
    "on-click": "/etc/profiles/per-user/jgertzell/bin/coffee-mode toggle"
  },
  "tray": {
    "spacing": 4
  }
}
