[global]
alignment="left"
corner_radius=0
follow="mouse"
font="JetBrainsMono Nerd Font 10"
format="<b>%s</b>\n%b"
frame_color="#285577"
frame_width=2
height=240
hide_duplicate_count=no
horizontal_padding=12
icon_position="left"
ignore_newline=no
markup="full"
max_icon_size=64
min_icon_size=32
monitor=0
mouse_left_click="close_current"
mouse_middle_click="do_action, close_current"
mouse_right_click="close_all"
notification_limit=5
offset="12x36"
origin="top-right"
padding=12
separator_color="frame"
show_age_threshold=60
show_indicators=yes
stack_duplicates=yes
vertical_alignment="center"
width=360
word_wrap=yes

[urgency_critical]
background="#900000"
foreground="#ffffff"
frame_color="#ff5555"
timeout=0

[urgency_low]
background="#000000"
foreground="#ffffff"
timeout=5

[urgency_normal]
background="#000000"
foreground="#ffffff"
timeout=8
