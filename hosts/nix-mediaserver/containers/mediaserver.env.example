TZ=Europe/Stockholm
PUID=1000
PGID=1001

# Discover with: getent group render; getent group video
RENDER_GID=303
VIDEO_GID=44

# Gluetun VPN settings for a WireGuard provider.
VPN_SERVICE_PROVIDER=custom
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=replace-me
WIREGUARD_ADDRESSES=replace-me
WIREGUARD_DNS=replace-me
WIREGUARD_PUBLIC_KEY=replace-me
WIREGUARD_ENDPOINT_IP=replace-me
WIREGUARD_ENDPOINT_PORT=51820
WIREGUARD_ALLOWED_IPS=0.0.0.0/0
WIREGUARD_PERSISTENT_KEEPALIVE_INTERVAL=25s
FIREWALL_OUTBOUND_SUBNETS=100.64.0.0/10,192.168.0.0/16
GLUETUN_HTTP_CONTROL_PORT=127.0.0.1:8000
JELLYFIN_BIND=0.0.0.0:8096
QBITTORRENT_WEBUI_BIND=0.0.0.0:8080

# If your VPN supports forwarded ports, set this to the forwarded port.
QBITTORRENT_LISTEN_PORT=6881

NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,video,utility

JELLYSEERR_LOG_LEVEL=info

# Optional: fill these after Sonarr/Radarr are configured.
UNPACKERR_SONARR_API_KEY=
UNPACKERR_RADARR_API_KEY=
